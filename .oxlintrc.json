{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "curly": ["error", "all"],
    "no-unused-vars": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "tailwind.config.js",
    "postcss.config.js",
    ".astro/**"
  ],
  "env": {
    "builtin": true,
    "browser": true
  }
}
