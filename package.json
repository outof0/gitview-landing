{
  "name": "gitview-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site for GitView — see Git clearly. Three-way merge for VS Code.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "astro check",
    "lint": "oxlint --deny-warnings src e2e playwright.config.ts astro.config.mjs",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "security:audit": "pnpm audit --prod --audit-level=moderate",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run check:dist",
    "ci": "pnpm run quality && pnpm run security:audit && pnpm run test:e2e"
  },
  "license": "MIT",
  "author": "OutOf0 <hello.outof0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/outof0/gitview-landing.git"
  },
  "homepage": "https://gitview.dev",
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "astro": "^7.4.2",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
